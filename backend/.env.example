# AGENTSHIELD backend configuration — copy to .env and adjust.
# NEVER commit real secrets. AGENTSHIELD is designed for zero paid services.

# JWT signing secret (demo default is intentionally weak — CHANGE FOR REAL USE)
AGENTSHIELD_SECRET=agentshield-dev-secret-change-in-production

# Token TTL in minutes
AGENTSHIELD_TOKEN_TTL_MIN=480

# Optional: override database location (default backend/data/agentshield.db)
# AGENTSHIELD_DATA_DIR=./data
# AGENTSHIELD_DATABASE_URL=sqlite:///./data/agentshield.db

# Optional local AI (Ollama). Deterministic fallback is ALWAYS available.
# Install Ollama, then: ollama pull qwen3:4b
# AGENTSHIELD_OLLAMA_URL=http://localhost:11434
AGENTSHIELD_OLLAMA_URL=
